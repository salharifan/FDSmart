rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user document exists
    function userExists() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper function to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return userExists() && getUserData().role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users Collection
    match /users/{userId} {
      // Allow read if authenticated and user exists in Firestore
      allow read: if userExists() && (isOwner(userId) || isAdmin());
      
      // Allow create only for new users (signup)
      // SECURITY: Force role to 'user' on create
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.email == request.auth.token.email;
      
      // Allow update only for owner, but prevent role changes
      // SECURITY: Users cannot change their own role
      allow update: if isOwner(userId) && 
                       request.resource.data.role == resource.data.role;
      
      // Allow delete only by admin, and prevent self-deletion
      // SECURITY: Admin cannot delete themselves
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
    
    // Menu Items Collection
    match /menuItems/{itemId} {
      // Anyone authenticated can read menu items
      allow read: if userExists();
      
      // Only admins can create, update, or delete menu items
      allow create, update, delete: if isAdmin();
    }
    
    // Orders Collection
    match /orders/{orderId} {
      // SECURITY: 
      // - Regular users can only read their own orders
      // - Admins can read ALL orders (for management/status updates in admin dashboard)
      // - But admins are blocked from Order History UI (enforced in Flutter app)
      allow read: if userExists() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // SECURITY: Admins cannot create orders (they manage, not order)
      // Users can create their own orders
      allow create: if userExists() && 
                       getUserData().role != 'admin' &&
                       request.resource.data.userId == request.auth.uid;
      
      // Only admins can update orders (status changes)
      allow update: if isAdmin();
      
      // Only admins can delete orders
      allow delete: if isAdmin();
    }
    
    // Reviews Collection
    match /reviews/{reviewId} {
      // Anyone authenticated can read reviews
      allow read: if userExists();
      
      // Users can create their own reviews
      allow create: if userExists() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own reviews, admins can do all
      allow update, delete: if userExists() && 
                               (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

